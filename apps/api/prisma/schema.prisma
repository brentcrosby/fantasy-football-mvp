generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FantasyTeam {
  id                String             @id @default(cuid())
  name              String             @db.VarChar(100)
  scoringFormat     ScoringFormat
  lineupSlots       LineupSlot[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rosterMemberships RosterMembership[]
}

model Player {
  id                String             @id
  name              String             @db.VarChar(100)
  position          Position
  nflTeam           String             @db.VarChar(3)
  byeWeek           Int
  injuryStatus      InjuryStatus       @default(HEALTHY)
  projectedPoints   Float
  targetShare       Float?
  rosterMemberships RosterMembership[]
}

model RosterMembership {
  fantasyTeamId String
  playerId      String
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([fantasyTeamId, playerId])
  @@index([playerId])
}

enum Position {
  QB
  RB
  WR
  TE
  K
  DST
}

enum ScoringFormat {
  STANDARD
  HALF_PPR
  PPR
}

enum LineupSlot {
  QB
  RB
  WR
  TE
  K
  DST
  FLEX
}

enum InjuryStatus {
  HEALTHY
  QUESTIONABLE
  DOUBTFUL
  OUT
  IR
  SUSPENDED
}
