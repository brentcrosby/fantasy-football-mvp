generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FantasyTeam {
  id                String             @id @default(cuid())
  userId            String?
  name              String             @db.VarChar(100)
  scoringFormat     ScoringFormat
  scoringRules      Json?
  lineupSlots       LineupSlot[]
  sleeperLeagueId   String?            @db.VarChar(30)
  sleeperRosterId   Int?
  sleeperUserId     String?            @db.VarChar(30)
  sleeperUsername   String?            @db.VarChar(50)
  sleeperSyncedAt   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rosterMemberships RosterMembership[]
  weeklyReports     WeeklyReport[]

  @@unique([userId, sleeperLeagueId])
  @@index([userId])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique @db.VarChar(320)
  passwordHash String        @db.VarChar(256)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  teams        FantasyTeam[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Player {
  id                     String                  @id
  name                   String                  @db.VarChar(100)
  position               Position
  nflTeam                String                  @db.VarChar(3)
  byeWeek                Int
  injuryStatus           InjuryStatus            @default(HEALTHY)
  projectedPoints        Float
  hasProjection          Boolean                 @default(true)
  projectionStats        Json?
  projectionSource       String?                 @db.VarChar(150)
  experimentalProjection Json?
  targetShare            Float?
  dataSource             PlayerDataSource        @default(SEED)
  externalId             String?                 @db.VarChar(50)
  gsisId                 String?                 @db.VarChar(20)
  season                 Int?
  projectionWeek         Int?
  dataUpdatedAt          DateTime?
  rosterMemberships      RosterMembership[]
  projectionObservations ProjectionObservation[]

  @@unique([dataSource, externalId])
  @@index([dataSource, season, projectionWeek])
}

model ProjectionObservation {
  id                      String    @id @default(cuid())
  playerId                String
  season                  Int
  week                    Int
  providerProjectedPoints Float
  modelProjectedPoints    Float?
  actualPprPoints         Float?
  capturedAt              DateTime  @default(now())
  resolvedAt              DateTime?
  player                  Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, week])
  @@index([season, week])
  @@index([actualPprPoints])
}

model PlayerDataSync {
  id              String   @id @db.VarChar(50)
  season          Int
  week            Int
  source          String   @db.VarChar(150)
  recordCount     Int
  sourceUpdatedAt DateTime
  syncedAt        DateTime
}

model RosterMembership {
  fantasyTeamId String
  playerId      String
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([fantasyTeamId, playerId])
  @@index([playerId])
}

model WeeklyReport {
  id             String        @id @default(cuid())
  fantasyTeamId  String
  teamName       String        @db.VarChar(100)
  week           Int
  scoringFormat  ScoringFormat
  scoringRules   Json?
  lineupSlots    LineupSlot[]
  rosterSnapshot Json
  reportSnapshot Json
  createdAt      DateTime      @default(now())
  fantasyTeam    FantasyTeam   @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)

  @@index([fantasyTeamId, createdAt])
}

enum Position {
  QB
  RB
  WR
  TE
  K
  DST
}

enum ScoringFormat {
  STANDARD
  HALF_PPR
  PPR
  CUSTOM
}

enum LineupSlot {
  QB
  RB
  WR
  TE
  K
  DST
  FLEX
}

enum InjuryStatus {
  HEALTHY
  QUESTIONABLE
  DOUBTFUL
  OUT
  IR
  SUSPENDED
}

enum PlayerDataSource {
  SEED
  LIVE
}
